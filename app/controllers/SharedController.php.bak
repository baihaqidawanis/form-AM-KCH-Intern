	/**
     * getcount_mf Model Action
     * @return Value
     */
	function getcount_mf(){
		$db = $this->GetModel();
		$sqltext = "SELECT COUNT(*) AS num FROM mf WHERE DATE(date_created) = DATE(NOW())";
		$queryparams = null;
		$val = $db->rawQueryValue($sqltext, $queryparams);
		
		if(is_array($val)){
			return $val[0];
		}
		return $val;
	}

	/**
     * getcount_rvs Model Action
     * @return Value
     */
	function getcount_sig(){
