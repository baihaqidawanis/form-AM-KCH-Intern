# Copy file ini jadi .env lalu isi sesuai environment (local XAMPP / Docker / server kantor).
# .env asli JANGAN di-commit (sudah di-exclude di .gitignore).

DB_HOST=localhost
DB_USERNAME=form_am_app
DB_PASSWORD=
DB_NAME=form_am_plg
DB_TYPE=pgsql
DB_PORT=5432
DB_CHARSET=utf8
# Kosongkan bila PostgreSQL memakai SSL bawaan. Untuk PostgreSQL internal
# dengan SHOW ssl = off, gunakan DB_SSLMODE=disable.
DB_SSLMODE=

# WAJIB false di server production (kantor) -- kalau true, pesan error PHP
# (termasuk full path server & stack trace) ke-tampilin ke response, bahkan
# ke request yang belum login sekalipun.
DEVELOPMENT_MODE=false

# SMTP -- dipakai buat kirim email reset password. Kalau USE_SMTP=false,
# fitur reset password lewat email gak akan ngirim apa-apa (cocok buat lokal
# tanpa akses SMTP). Buat tes lokal tanpa akun email beneran, bisa pakai
# akun gratis dari https://ethereal.email (generate instan, bukan buat production).
USE_SMTP=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
DEFAULT_EMAIL=
DEFAULT_EMAIL_ACCOUNT_NAME=Form AM Site Pulogadung

# Minimal 32 byte acak. Contoh pembuatan: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# Jangan gunakan nilai contoh dan jangan commit secret production.
SIGNATURE_HMAC_KEY=
